{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "incremental": false,
    "skipLibCheck": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "lib/**/*.mts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "db/**",
    "worker/**",
    "supabase/**",
    "scripts/**",
    "dist/**"
  ]
}
